# LLM
GEMINI_API_KEY=REPLACE_WITH_YOUR_KEY
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
LLM_MODEL=gpt-4o-mini

# Databases
POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/docintel
REDIS_URL=redis://redis:6379/0
WEAVIATE_URL=http://weaviate:8080

# Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# App
LOG_LEVEL=INFO
ENV=dev

# Service URLs (for API Gateway)
CV_SERVICE_URL=http://localhost:8001
NLP_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://localhost:8003
SUMMARY_SERVICE_URL=http://localhost:8005
PROMPT_SERVICE_URL=http://localhost:8006
JOBS_DIR=data/jobs